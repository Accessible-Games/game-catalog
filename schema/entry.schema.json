{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.accessiblegames.net/schema/entry.schema.json",
  "title": "Catalog entry",
  "$ref": "#/$defs/fields",
  "unevaluatedProperties": false,
  "$defs": {
    "fields": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "game",
            "extra",
            "runtime",
            "access-mod"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "developer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1970,
          "maximum": 2100
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "abandoned",
              "demo",
              "beta",
              "multiplayer",
              "requires-registration",
              "registration"
            ]
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "homepage": {
              "type": "string",
              "format": "uri"
            },
            "purchase": {
              "type": "string",
              "format": "uri"
            },
            "audiogames_net": {
              "type": "string",
              "format": "uri"
            },
            "agarchive": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "launch": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "web"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "args": {
                "type": "string"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "extends": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "install_into": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "note"
          ],
          "properties": {
            "note": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "detect": {
          "type": "object"
        },
        "checkver": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "github"
              ],
              "properties": {
                "github": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "regex"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "regex": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "platform",
        "install"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "linux",
            "web"
          ]
        },
        "size": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "zip",
            "7z",
            "installer",
            "cab",
            "none",
            "url"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "extract_dir": {
          "type": "string"
        },
        "installer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "mode"
          ],
          "properties": {
            "type": {
              "enum": [
                "inno",
                "nsis",
                "msi",
                "installshield",
                "other"
              ]
            },
            "mode": {
              "enum": [
                "extract",
                "run"
              ]
            },
            "silent_args": {
              "type": "string"
            },
            "elevation": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "from",
            "to"
          ],
          "properties": {
            "action": {
              "enum": [
                "copy",
                "move"
              ]
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path"
          ],
          "properties": {
            "action": {
              "const": "delete"
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "hive",
            "key",
            "name",
            "type",
            "value"
          ],
          "properties": {
            "action": {
              "const": "registry"
            },
            "hive": {
              "enum": [
                "HKCU",
                "HKLM"
              ]
            },
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "REG_SZ",
                "REG_DWORD"
              ]
            },
            "value": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path"
          ],
          "properties": {
            "action": {
              "const": "register"
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path"
          ],
          "properties": {
            "action": {
              "const": "run"
            },
            "path": {
              "type": "string"
            },
            "args": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
