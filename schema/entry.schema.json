{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.accessiblegames.net/schema/entry.schema.json",
  "title": "Catalog entry",
  "$ref": "#/$defs/fields",
  "unevaluatedProperties": false,
  "$defs": {
    "fields": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "game",
            "extra",
            "runtime",
            "access-mod"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "developer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "genres": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Action",
              "Adventure",
              "Arcade",
              "Board and dice",
              "Card",
              "Casino",
              "Educational",
              "Fighting",
              "Interactive fiction",
              "Music and rhythm",
              "Platformer",
              "Puzzle",
              "Racing",
              "Role-playing",
              "Shooter",
              "Simulation",
              "Sports",
              "Strategy",
              "Trivia",
              "Word"
            ]
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1970,
          "maximum": 2100
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "self_updating": {
          "const": true
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Multiplayer",
              "Roguelike",
              "Idle",
              "Survival",
              "Horror"
            ]
          }
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported": {
          "const": true
        },
        "warning": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "launch": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "web"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "args": {
                "type": "string"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "extends": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "install_into": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "detect": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "registry"
              ],
              "properties": {
                "registry": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hive",
                    "key"
                  ],
                  "properties": {
                    "hive": {
                      "enum": [
                        "HKCR",
                        "HKLM",
                        "HKCU"
                      ]
                    },
                    "key": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          ]
        },
        "checkver": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "github"
              ],
              "properties": {
                "github": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "regex"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "regex": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "enum": [
            "free",
            "free-to-try",
            "pay-what-you-want",
            "one-time",
            "subscription",
            "free-with-purchases"
          ]
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "suggested": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "enum": [
            "month",
            "year"
          ]
        },
        "checked": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "no_longer_sold": {
          "const": true
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "donate_url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "platform",
        "install"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "linux",
            "web"
          ]
        },
        "arch": {
          "enum": [
            "x64",
            "x86",
            "arm64",
            "universal"
          ]
        },
        "size": {
          "type": "integer"
        },
        "first_run_download_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "zip",
            "7z",
            "installer",
            "cab",
            "tar",
            "none",
            "url"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "extract_dir": {
          "type": "string"
        },
        "installer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "mode"
          ],
          "properties": {
            "type": {
              "enum": [
                "inno",
                "nsis",
                "msi",
                "installshield",
                "other"
              ]
            },
            "mode": {
              "enum": [
                "extract",
                "run"
              ]
            },
            "silent_args": {
              "type": "string"
            },
            "elevation": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "from",
            "to"
          ],
          "properties": {
            "action": {
              "enum": [
                "copy",
                "move"
              ]
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path"
          ],
          "properties": {
            "action": {
              "const": "delete"
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "hive",
            "key",
            "name",
            "type",
            "value"
          ],
          "properties": {
            "action": {
              "const": "registry"
            },
            "hive": {
              "enum": [
                "HKCU",
                "HKLM"
              ]
            },
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "REG_SZ",
                "REG_DWORD"
              ]
            },
            "value": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path"
          ],
          "properties": {
            "action": {
              "const": "register"
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path"
          ],
          "properties": {
            "action": {
              "const": "run"
            },
            "path": {
              "type": "string"
            },
            "args": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
